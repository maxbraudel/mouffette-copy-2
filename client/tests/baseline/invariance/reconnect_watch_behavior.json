{
  "id": "reconnect_endpoint_discovery_behavior",
  "rules": [
    {
      "file": "src/backend/handlers/ClientListEventHandler.cpp",
      "mustContain": [
        "clientListReceived",
        "candidate.endpointId\\(\\) == activeSessionIdentity"
      ]
    },
    {
      "file": "src/backend/network/WebSocketClient.cpp",
      "mustContain": [
        "resumeAllRemoteSessions\\(",
        "reauthenticatedWithinLease",
        "clientListReceived"
      ]
    }
  ]
}
