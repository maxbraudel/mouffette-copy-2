{
  "id": "workspace_behavior",
  "rules": [
    {
      "file": "src/backend/domain/workspace/WorkspaceManager.h",
      "mustContain": [
        "QString targetEndpointId",
        "QString projectId",
        "ICanvasHost\\* canvas"
      ]
    },
    {
      "file": "src/backend/controllers/ClientWorkspaceController.cpp",
      "mustContain": [
        "getOrCreateWorkspace",
        "setActiveProjectId\\(workspace->projectId\\)"
      ]
    }
  ]
}
