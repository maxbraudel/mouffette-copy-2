{
  "id": "mandatory_quick_path",
  "rules": [
    {
      "file": "src/backend/controllers/CanvasSessionController.cpp",
      "mustContain": [
        "const bool quickRequested = true",
        "mandatory_quick_init_failed",
        "mandatory Qt Quick canvas unavailable"
      ]
    },
    {
      "file": "src/frontend/rendering/canvas/QuickCanvasController.cpp",
      "mustContain": [
        "QQuickWidget::Ready",
        "Qt Quick canvas root object was not created"
      ]
    },
    {
      "file": "src/frontend/rendering/remote/RemoteSceneController.cpp",
      "mustContain": [
        "Qt Quick remote renderer failed to initialize"
      ]
    }
  ]
}
