{
  "id": "qml_only_application_path",
  "rules": [
    {
      "file": "src/backend/controllers/CanvasSessionController.cpp",
      "mustContain": [
        "QuickCanvasHost::create",
        "mandatory Qt Quick canvas unavailable"
      ]
    },
    {
      "file": "src/frontend/rendering/canvas/QuickCanvasController.cpp",
      "mustContain": [
        "registerWindow",
        "mediaSnapshot",
        "presentationChanged"
      ]
    },
    {
      "file": "src/frontend/rendering/remote/RemoteSceneController.cpp",
      "mustContain": [
        "RemoteSceneWindow.qml",
        "createWithInitialProperties"
      ]
    },
    {
      "file": "CMakeLists.txt",
      "mustContain": [
        "qt_add_qml_module",
        "QmlArchitectureGate"
      ]
    }
  ]
}
