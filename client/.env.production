# Final overrides for every production-channel (Release) build.
# Keys absent from this file keep the value resolved from the normal runtime
# configuration chain. Keys present here cannot be overridden at runtime.

MOUFFETTE_ALLOW_MULTIPLE_INSTANCES=false

# Timeline values inherit client.env and remain configurable at runtime.
# Add a key here only when a deployment must enforce it.
# MOUFFETTE_TIMELINE_MAX_DURATION_MS=180000
# MOUFFETTE_TIMELINE_SLOTS_PER_SECOND=30
# MOUFFETTE_TIMELINE_DEFAULT_CLIP_DURATION_SLOTS=30
# MOUFFETTE_TIMELINE_HEIGHT_PX=240
# MOUFFETTE_TIMELINE_RULER_HEIGHT_PX=28
# MOUFFETTE_TIMELINE_CLIP_TRACK_HEIGHT_PX=48
# MOUFFETTE_TIMELINE_KEYFRAME_SIZE_PX=10
# MOUFFETTE_TIMELINE_OTHER_KEYFRAME_OPACITY_PERCENT=30
# MOUFFETTE_TIMELINE_SNAP_DISTANCE_PX=10
# MOUFFETTE_TIMELINE_INITIAL_VIEW_DURATION_MS=15000
