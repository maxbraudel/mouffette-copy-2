# Mouffette client runtime defaults. This tracked file contains no secrets and
# is embedded in the application. Replace it with --env-file <path> or the
# MOUFFETTE_ENV_FILE process variable; override individual values with process
# variables or their matching command-line options.

MOUFFETTE_SERVER_URL=ws://localhost:8080

# Keep 548 MiB available to the system; remaining RAM can load media and buffers.
# The optional percent is a minimum free share of total RAM, not a media cap:
# reserve = max(total RAM * percent / 100, minimum MiB). Leave percent at 0
# for a fixed MiB reserve. 1024 MiB = 1 GiB; valid integers: percent 0..100,
# minimum MiB 0..2147483647. Set both to 0 to disable this reserve.
# Applied at startup: rebuild after editing this embedded file, or restart
# with --env-file <path> to use an external file without rebuilding.
MOUFFETTE_MEDIA_RAM_RESERVE_PERCENT=0
MOUFFETTE_MEDIA_RAM_RESERVE_MIN_MIB=0

# All deadlines are fixed from the first hiddenAt instant; repeated hide events
# never extend them. Media RAM is released independently of session closure,
# and reloaded when the project becomes visible. Both timeouts must be shorter
# than project retention. Media timeout: integer 1000..86400000 milliseconds.
MOUFFETTE_PROJECT_MEDIA_HIDDEN_TIMEOUT_MS=40000
MOUFFETTE_REMOTE_SESSION_HIDDEN_TIMEOUT_MS=20000
MOUFFETTE_PROJECT_HIDDEN_RETENTION_MS=60000

# Legacy standalone watchdog configuration (not used by the v7 runtime).
# Incoming and outgoing v7 sessions share the server-advertised recovery
# deadline: MOUFFETTE_REMOTE_SESSION_RECOVERY_TIMEOUT_MS in server/.env.
MOUFFETTE_INCOMING_SESSION_ORPHAN_TIMEOUT_MS=3000
MOUFFETTE_UPLOAD_IDLE_TIMEOUT_MS=45000
# Retry waits are separate from attempt timeouts and server session recovery.
# MAX values include jitter. Configuration changes require an application restart.
MOUFFETTE_CONNECTION_SYNC_TIMEOUT_MS=10000
MOUFFETTE_SESSION_RETRY_BASE_MS=1000
MOUFFETTE_SESSION_RETRY_MAX_MS=5000
MOUFFETTE_CONTROL_REQUEST_RETRY_MS=1000
MOUFFETTE_UPLOAD_CHANNEL_RETRY_BASE_MS=1000
MOUFFETTE_UPLOAD_CHANNEL_RETRY_MAX_MS=5000
MOUFFETTE_UPLOAD_CHANNEL_ATTEMPT_TIMEOUT_MS=10000
MOUFFETTE_DEFERRED_CLEANUP_RETRY_MAX_MS=30000
MOUFFETTE_CONNECTION_ATTEMPT_TIMEOUT_MS=10000
MOUFFETTE_RECONNECT_FAST_STEP_MS=250
MOUFFETTE_RECONNECT_FAST_MAX_MS=750
MOUFFETTE_RECONNECT_BASE_MS=1000
MOUFFETTE_RECONNECT_MAX_MS=5000
MOUFFETTE_RECONNECT_JITTER_PERCENT=20
MOUFFETTE_RECONNECT_STABLE_RESET_MS=30000
MOUFFETTE_LEASE_HEALTH_CHECK_INTERVAL_MS=100
MOUFFETTE_SESSION_DEADLINE_POLL_INTERVAL_MS=250
MOUFFETTE_PROJECT_AUTOSAVE_DELAY_MS=300
MOUFFETTE_PROJECT_CHECKPOINT_INTERVAL_MS=15000
MOUFFETTE_PROJECT_DEADLINE_POLL_INTERVAL_MS=250
MOUFFETTE_SCREEN_CHANGE_DEBOUNCE_MS=150
MOUFFETTE_SYSTEM_VOLUME_POLL_INTERVAL_MS=1200
MOUFFETTE_FILE_WATCH_DEBOUNCE_MS=500
MOUFFETTE_SCENE_ACTIVITY_REFRESH_INTERVAL_MS=1000
MOUFFETTE_CLIENT_COUNTDOWN_REFRESH_INTERVAL_MS=1000
MOUFFETTE_VIDEO_STATE_PUBLISH_INTERVAL_MS=50
MOUFFETTE_VIDEO_SNAPSHOT_INTERVAL_MS=1000
MOUFFETTE_REMOTE_WINDOW_SHOW_DELAY_MS=10
MOUFFETTE_MEDIA_PROBE_TIMEOUT_MS=5000
MOUFFETTE_INCOMING_UPLOAD_COMPLETION_TTL_MS=60000
MOUFFETTE_DEFERRED_CLEANUP_RETRY_MS=1000
MOUFFETTE_SCENE_LAUNCH_TIMEOUT_MARGIN_MS=1000
MOUFFETTE_INSTANCE_ACTIVATION_CONNECT_TIMEOUT_MS=100
MOUFFETTE_INSTANCE_ACTIVATION_ACK_TIMEOUT_MS=250
MOUFFETTE_INSTANCE_ACTIVATION_RETRY_INTERVAL_MS=25
MOUFFETTE_CONTROLLED_DISCONNECT_DRAIN_TIMEOUT_MS=10000
MOUFFETTE_PROCESS_STOP_TIMEOUT_MS=100
MOUFFETTE_UPLOAD_ACTION_MIN_INTERVAL_MS=300
MOUFFETTE_UPLOAD_CANCEL_GUARD_MS=1000
MOUFFETTE_SCENE_SEEK_POSITION_TOLERANCE_MS=120
MOUFFETTE_SCENE_START_FRAME_TOLERANCE_MS=25
MOUFFETTE_SCENE_DECODER_SYNC_TOLERANCE_MS=25
MOUFFETTE_SCENE_VIDEO_SYNC_POSITION_TOLERANCE_MS=400
MOUFFETTE_SCENE_VIDEO_SYNC_TRANSIT_MAX_MS=2000
MOUFFETTE_SCENE_AUTHORITATIVE_SEEK_GUARD_MS=250
MOUFFETTE_SCENE_REPEAT_TRIGGER_GUARD_MS=500
MOUFFETTE_UI_CONTENT_FADE_DURATION_MS=200
MOUFFETTE_UI_SPINNER_ROTATION_DURATION_MS=900
MOUFFETTE_UI_SCROLLBAR_HIDE_DELAY_MS=500
MOUFFETTE_UI_INPUT_WATCHDOG_INTERVAL_MS=120
MOUFFETTE_UI_SNAP_FREEZE_CLEANUP_DELAY_MS=300
# Initial fit-to-text block height as a share of the central viewport square.
# Integer 1..100. Applied once at creation; subsequent zoom does not resize media.
# Rebuild after editing this embedded file, or restart with --env-file <path>.
MOUFFETTE_CANVAS_TEXT_INITIAL_HEIGHT_PERCENT=10
# Remote cursor diameter in logical view pixels (integer 4..256), independent of zoom.
# Rebuild after editing this embedded file, or restart with --env-file <path>.
MOUFFETTE_REMOTE_CURSOR_DIAMETER_PX=10
MOUFFETTE_TOAST_DEFAULT_DURATION_MS=4000
MOUFFETTE_TOAST_INFO_DURATION_MS=2000
MOUFFETTE_TOAST_WARNING_DURATION_MS=3500
MOUFFETTE_TOAST_ERROR_DURATION_MS=5000
MOUFFETTE_TOAST_ANIMATION_DURATION_MS=300

MOUFFETTE_UPLOAD_CONCURRENCY=2
MOUFFETTE_AUTO_UPLOAD_IMPORTED_MEDIA=false
QT_MEDIA_BACKEND=ffmpeg

# Allow extra local processes. All use stable installation + instance-number
# endpoints; only runtime 1 persists. Secondary profile data is disposable.
# This embedded default is selected before building; no live mode toggle exists.
MOUFFETTE_ALLOW_MULTIPLE_INSTANCES=true

# Diagnostics.
MOUFFETTE_CURSOR_DEBUG=false
MOUFFETTE_RUNTIME_DIAGNOSTICS=false
MOUFFETTE_CANVAS_PROFILING=false

# Timeline: duration and cadence are copied into new projects; visual settings apply to all.
MOUFFETTE_TIMELINE_MAX_DURATION_MS=180000
# Whole slots per second (1–240); video retains its native cadence.
MOUFFETTE_TIMELINE_SLOTS_PER_SECOND=30
MOUFFETTE_TIMELINE_HEIGHT_PX=240
MOUFFETTE_TIMELINE_RULER_HEIGHT_PX=28
MOUFFETTE_TIMELINE_CLIP_TRACK_HEIGHT_PX=64
MOUFFETTE_TIMELINE_KEYFRAME_SIZE_PX=10
MOUFFETTE_TIMELINE_OTHER_KEYFRAME_OPACITY_PERCENT=30
MOUFFETTE_TIMELINE_SNAP_DISTANCE_PX=10
MOUFFETTE_TIMELINE_INITIAL_VIEW_DURATION_MS=15000
