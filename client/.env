# Mouffette client runtime defaults. This tracked file contains no secrets and
# is embedded in the application. Replace it with --env-file <path> or the
# MOUFFETTE_ENV_FILE process variable; override individual values with process
# variables or their matching command-line options.

MOUFFETTE_SERVER_URL=ws://localhost:8080

# Both deadlines are fixed from the first hiddenAt instant. Reopening before
# 60 seconds keeps the session; reopening later restores only the project. The
# five-minute deletion deadline is never extended by repeated hide events.
MOUFFETTE_REMOTE_SESSION_HIDDEN_TIMEOUT_MS=60000
MOUFFETTE_PROJECT_HIDDEN_RETENTION_MS=300000

MOUFFETTE_UPLOAD_CONCURRENCY=2
MOUFFETTE_AUTO_UPLOAD_IMPORTED_MEDIA=false
MOUFFETTE_USE_QUICK_CANVAS_RENDERER=true
QT_MEDIA_BACKEND=ffmpeg

# Diagnostics and multi-instance development support.
MOUFFETTE_INSTANCE_SUFFIX=
MOUFFETTE_CURSOR_DEBUG=false
MOUFFETTE_RUNTIME_DIAGNOSTICS=false
MOUFFETTE_MIGRATION_TELEMETRY=false
MOUFFETTE_CANVAS_PROFILING=false
