# Mouffette client runtime defaults. This tracked file contains no secrets and
# is embedded in the application. Replace it with --env-file <path> or the
# MOUFFETTE_ENV_FILE process variable; override individual values with process
# variables or their matching command-line options.

MOUFFETTE_SERVER_URL=ws://localhost:8080

# Media RAM safety reserve = max(total RAM * percent / 100, minimum MiB).
# Applied at startup; 1024 MiB = 1 GiB. Valid integers: percent 0..100,
# minimum MiB 0..2147483647. Set both to 0 to disable this reserve.
MOUFFETTE_MEDIA_RAM_RESERVE_PERCENT=5
MOUFFETTE_MEDIA_RAM_RESERVE_MIN_MIB=548

# Both deadlines are fixed from the first hiddenAt instant. Reopening before
# 60 seconds keeps the session; reopening later restores only the project. The
# five-minute deletion deadline is never extended by repeated hide events.
MOUFFETTE_REMOTE_SESSION_HIDDEN_TIMEOUT_MS=30000
MOUFFETTE_PROJECT_HIDDEN_RETENTION_MS=60000

# Receiver-side fail-safe. If server authority cannot be re-established for
# an incoming RemoteSession, its scenes and received media are invalidated
# locally without waiting for the sender or the server.
MOUFFETTE_INCOMING_SESSION_ORPHAN_TIMEOUT_MS=3000
MOUFFETTE_UPLOAD_IDLE_TIMEOUT_MS=45000
MOUFFETTE_CONNECTION_ATTEMPT_TIMEOUT_MS=3000
MOUFFETTE_RECONNECT_FAST_STEP_MS=250
MOUFFETTE_RECONNECT_FAST_MAX_MS=750
MOUFFETTE_RECONNECT_BASE_MS=1000
MOUFFETTE_RECONNECT_MAX_MS=30000
MOUFFETTE_RECONNECT_JITTER_PERCENT=20
MOUFFETTE_LEASE_HEALTH_CHECK_INTERVAL_MS=100
MOUFFETTE_SESSION_DEADLINE_POLL_INTERVAL_MS=250
MOUFFETTE_PROJECT_AUTOSAVE_DELAY_MS=300
MOUFFETTE_PROJECT_CHECKPOINT_INTERVAL_MS=15000
MOUFFETTE_PROJECT_DEADLINE_POLL_INTERVAL_MS=250
MOUFFETTE_SCREEN_CHANGE_DEBOUNCE_MS=150
MOUFFETTE_SYSTEM_VOLUME_POLL_INTERVAL_MS=1200
MOUFFETTE_FILE_WATCH_DEBOUNCE_MS=500
MOUFFETTE_SCENE_ACTIVITY_REFRESH_INTERVAL_MS=1000
MOUFFETTE_CLIENT_COUNTDOWN_REFRESH_INTERVAL_MS=1000
MOUFFETTE_VIDEO_STATE_PUBLISH_INTERVAL_MS=50
MOUFFETTE_VIDEO_SNAPSHOT_INTERVAL_MS=1000
MOUFFETTE_REMOTE_WINDOW_SHOW_DELAY_MS=10
MOUFFETTE_MEDIA_PROBE_TIMEOUT_MS=5000
MOUFFETTE_INCOMING_UPLOAD_COMPLETION_TTL_MS=60000
MOUFFETTE_DEFERRED_CLEANUP_RETRY_MS=1000
MOUFFETTE_SCENE_LAUNCH_TIMEOUT_MARGIN_MS=1000
MOUFFETTE_INSTANCE_ACTIVATION_CONNECT_TIMEOUT_MS=100
MOUFFETTE_INSTANCE_ACTIVATION_ACK_TIMEOUT_MS=250
MOUFFETTE_INSTANCE_ACTIVATION_RETRY_INTERVAL_MS=25
MOUFFETTE_CONTROLLED_DISCONNECT_DRAIN_TIMEOUT_MS=10000
MOUFFETTE_PROCESS_STOP_TIMEOUT_MS=100
MOUFFETTE_UPLOAD_ACTION_MIN_INTERVAL_MS=300
MOUFFETTE_UPLOAD_CANCEL_GUARD_MS=1000
MOUFFETTE_SCENE_SEEK_POSITION_TOLERANCE_MS=120
MOUFFETTE_SCENE_START_FRAME_TOLERANCE_MS=25
MOUFFETTE_SCENE_DECODER_SYNC_TOLERANCE_MS=25
MOUFFETTE_SCENE_VIDEO_SYNC_POSITION_TOLERANCE_MS=400
MOUFFETTE_SCENE_VIDEO_SYNC_TRANSIT_MAX_MS=2000
MOUFFETTE_SCENE_AUTHORITATIVE_SEEK_GUARD_MS=250
MOUFFETTE_SCENE_REPEAT_TRIGGER_GUARD_MS=500
MOUFFETTE_UI_CONTENT_FADE_DURATION_MS=80
MOUFFETTE_UI_SPINNER_ROTATION_DURATION_MS=900
MOUFFETTE_UI_SCROLLBAR_HIDE_DELAY_MS=500
MOUFFETTE_UI_INPUT_WATCHDOG_INTERVAL_MS=120
MOUFFETTE_UI_SNAP_FREEZE_CLEANUP_DELAY_MS=300
MOUFFETTE_TOAST_DEFAULT_DURATION_MS=4000
MOUFFETTE_TOAST_INFO_DURATION_MS=2000
MOUFFETTE_TOAST_WARNING_DURATION_MS=3500
MOUFFETTE_TOAST_ERROR_DURATION_MS=5000
MOUFFETTE_TOAST_ANIMATION_DURATION_MS=300

MOUFFETTE_UPLOAD_CONCURRENCY=2
MOUFFETTE_AUTO_UPLOAD_IMPORTED_MEDIA=false
QT_MEDIA_BACKEND=ffmpeg

# Development builds may allocate isolated secondary runtime profiles.
MOUFFETTE_ALLOW_MULTIPLE_INSTANCES=true

# Diagnostics.
MOUFFETTE_CURSOR_DEBUG=false
MOUFFETTE_RUNTIME_DIAGNOSTICS=false
MOUFFETTE_CANVAS_PROFILING=false
