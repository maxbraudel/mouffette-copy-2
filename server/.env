MOUFFETTE_SERVER_HOST=0.0.0.0
MOUFFETTE_SERVER_PORT=8080
MOUFFETTE_AUTH_CHALLENGE_TIMEOUT_MS=10000
MOUFFETTE_PEER_HEARTBEAT_INTERVAL_MS=750
# A lost socket, or two missed heartbeat intervals, starts one fixed recovery period.
MOUFFETTE_REMOTE_SESSION_RECOVERY_TIMEOUT_MS=15000
MOUFFETTE_TRANSPORT_TIMEOUT_MS=5000
MOUFFETTE_SESSION_LEASE_SWEEP_INTERVAL_MS=100
MOUFFETTE_REMOTE_SESSION_OPEN_TIMEOUT_MS=5000
MOUFFETTE_REMOTE_SESSION_OPEN_REQUEST_TTL_MS=300000
MOUFFETTE_REMOTE_SESSION_TOMBSTONE_TTL_MS=300000
MOUFFETTE_REMOTE_SESSION_TEARDOWN_RETRY_INITIAL_MS=500
MOUFFETTE_REMOTE_SESSION_TEARDOWN_RETRY_MAX_MS=5000
MOUFFETTE_SCENE_PREPARE_TIMEOUT_MS=15000
MOUFFETTE_SCENE_ACTIVATION_LEAD_MS=500
MOUFFETTE_SCENE_MAX_CLOCK_SKEW_MS=250
MOUFFETTE_SCENE_STARTED_ACK_TIMEOUT_MS=5000
MOUFFETTE_SCENE_MAX_START_SKEW_MS=750
MOUFFETTE_SCENE_STOP_TIMEOUT_MS=3000
MOUFFETTE_SCENE_RUN_TOMBSTONE_TTL_MS=60000
MOUFFETTE_UPLOAD_IDLE_TIMEOUT_MS=45000
MOUFFETTE_UPLOAD_TARGET_ACK_TIMEOUT_MS=30000
MOUFFETTE_UPLOAD_CHANNEL_TOKEN_TTL_MS=30000
MOUFFETTE_UPLOAD_SWEEP_INTERVAL_MS=5000
MOUFFETTE_UPLOAD_RESULT_TOMBSTONE_TTL_MS=60000
MOUFFETTE_REMOVAL_ACK_TIMEOUT_MS=30000
MOUFFETTE_ASSET_REMOVAL_TOMBSTONE_TTL_MS=60000
MOUFFETTE_STATS_INTERVAL_MS=30000
MOUFFETTE_CURSOR_DEBUG=false

# Screen video: bounded, ephemeral delivery and coalesced receiver feedback.
# One standalone H.264 keyframe may exceed the queue watermark (hard cap 2 MiB).
MOUFFETTE_SCREEN_FEEDBACK_INTERVAL_MS=500
MOUFFETTE_SCREEN_ACK_TIMEOUT_MS=3000
MOUFFETTE_SCREEN_MAX_BUFFERED_KIB=2048
MOUFFETTE_SCREEN_MAX_INFLIGHT_FRAMES=64
MOUFFETTE_SCREEN_KEYFRAME_REQUEST_INTERVAL_MS=1000
MOUFFETTE_SCREEN_QUEUE_TARGET_MS=150

# Shared H.264 publications: CPU-only forwarding, at most main + low upstream.
MOUFFETTE_SCREEN_SHARED_ENABLED=true
MOUFFETTE_SCREEN_MAX_VIEWERS_PER_PUBLISHER=10
MOUFFETTE_SCREEN_MAX_PUBLICATIONS=256
MOUFFETTE_SCREEN_KEYFRAME_CACHE_MIB=16
MOUFFETTE_SCREEN_KEYFRAME_CACHE_TTL_MS=5000
MOUFFETTE_SCREEN_SERVER_EGRESS_BPS=100000000
MOUFFETTE_SCREEN_VIEWER_MIN_BPS=64000
MOUFFETTE_SCREEN_VIEWER_INITIAL_BPS=3000000
MOUFFETTE_SCREEN_VIEWER_MAX_BPS=20000000
MOUFFETTE_SCREEN_VIEWER_RECOVERY_MS=3000
MOUFFETTE_SCREEN_SNAPSHOT_INTERVAL_MS=1000
MOUFFETTE_SCREEN_SNAPSHOT_MAX_TRANSFER_MS=4000
MOUFFETTE_SCREEN_VIEWER_UPLOAD_PERCENT=40
